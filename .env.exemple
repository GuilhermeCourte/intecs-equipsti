# ---------- SQL Server ----------
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Instância nomeada (ex.: SQLEXPRESS). Deixe vazio se não usar.
DB_INSTANCE=

# Conexão TLS — para SQL Server local geralmente:
DB_ENCRYPT=
DB_TRUST_SERVER_CERT=

# ---------- Autenticação (JWT) ----------
JWT_SECRET=
JWT_EXPIRES_HOURS=

# ---------- Biometria (WebAuthn — login por digital/rosto no celular) ----------
# RP_ID = domínio (sem protocolo/porta). ORIGIN = URL completa de acesso.
# Exige HTTPS no celular. Em dev local: localhost / http://localhost:3000
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# ---------- Primeiro administrador (criado pelo "npm run init-db") ----------
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------- E-mail das notificações (SMTP genérico) ----------
# Se SMTP_HOST ficar vazio, o e-mail é desativado: o sininho continua
# funcionando normalmente e o envio de e-mail é apenas pulado.
# SMTP_SECURE=true  => porta 465 (SSL);  false => porta 587 (STARTTLS).
# IMPORTANTE: a maioria dos servidores EXIGE autenticação — preencha SMTP_USER e
# SMTP_PASSWORD — e que o remetente (SMTP_FROM) seja o MESMO mailbox autenticado.
# Enviar "como" outro endereço (ex.: nao-responder@) costuma resultar em
# "453 4.7.1 Recipient address rejected: Access Denied".
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Use o MESMO endereço do SMTP_USER. Ex.: Gestão TI <usuario@intecsbr.org>
SMTP_FROM=
# Logo no topo do e-mail (URL pública https). Se vazio, usa WEBAUTHN_ORIGIN
# (quando https) + /logo_intecs.png; senão mostra só o texto "Gestão TI".
EMAIL_LOGO_URL=

# ---------- Push (Web Push/VAPID — notificações do app admin) ----------
# Gerar o par de chaves com: npx web-push generate-vapid-keys
# Se qualquer uma das três ficar vazia, o push é desativado: o sininho e o
# e-mail continuam funcionando normalmente e a inscrição/envio é só pulada.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: ou https:// — contato que o serviço de push (FCM/autopush) usa para
# falar com o dono do site se o tráfego parecer abusivo.
VAPID_SUBJECT=

# ---------- Servidor ----------
PORT=3000

# ---------- Senhas de acesso às portas (aba Suporte > Senhas) ----------
# Chave AES-256 (32 bytes em hex, 64 caracteres) para cifrar/decifrar as senhas
# de 4 dígitos das portas. Sem isto, a aba responde 503 (não grava em claro).
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SENHAS_CHAVE=

# ---------- Tactical RMM ----------
TACTICALRMM_API_URL=
TACTICALRMM_API_KEY=
# URL da interface web (nao da API). So e usada para montar o link do Remote
# Background dos agentes Linux, que nao tem conexao remota grafica.
TACTICALRMM_WEB_URL=

# ---------- MSA / eurosa (aba Chamados e INTECS vs MSA) ----------
# Credenciais do portal de chamados da MSA. Sem elas as duas abas ficam vazias:
# a sincronizacao falha e so aparece o que ja esta no banco.
# EUROSA_PREFIXO e o subdominio do cliente na URL do portal.
EUROSA_PREFIXO=
EUROSA_LOGIN=
EUROSA_SENHA=

# ---------- UptimeRobot (aba Internet > Conexao) ----------
# Chave READ-ONLY gerada em Integrations & API no uptimerobot.com.
# So leitura de status dos monitores; o GTI nao envia nenhum aviso
# (os alertas por e-mail continuam sendo configurados la).
UPTIMEROBOT_API_KEY=

# Id da pagina de status publica (o final da URL stats.uptimerobot.com/XXXX).
# De onde sai o uptime de 90 dias da lista de barrinhas: e bem mais rapido que
# montar os dias pela API v2. Sem isto, o painel cai na v2 e mostra 30 dias.
UPTIMEROBOT_PSP_ID=

# ---------- Hostinger (aba Suporte > VPS) ----------
# Token da API da Hostinger (developers.hostinger.com), gerado em
# hPanel > API. So leitura: a aba VPS nunca liga/desliga/reinicia nada,
# so mostra status, specs, metricas e o historico de acoes.
API_HOSTINGER=

# ---------- Google Workspace (aba Logs > fonte "Google Drive") ----------
# Auditoria do Drive pela Admin SDK Reports API, so leitura. Sem estas tres
# variaveis a fonte "Google Drive" responde 502 e o resto do sistema segue igual.
#
# Como preparar (uma vez):
#  1. GCP > seu projeto > ativar a "Admin SDK API".
#  2. Criar uma Service Account e gerar uma chave JSON.
#  3. Copiar o Client ID NUMERICO dessa conta de servico.
#  4. Admin Console > Seguranca > Controle de acesso e dados > Controles de API
#     > Delegacao em todo o dominio > adicionar o Client ID com OS DOIS escopos
#     (no mesmo Client ID, separados por virgula — editar a entrada substitui a
#     lista inteira, entao nunca deixe so um):
#     https://www.googleapis.com/auth/admin.reports.audit.readonly
#     https://www.googleapis.com/auth/drive.readonly   (usado pela aba
#     Utilitarios; ativar tambem a "Google Drive API" no GCP)
#  5. GOOGLE_ADMIN_SUBJECT = e-mail de um super admin. E OBRIGATORIO: a conta de
#     servico nao tem identidade no Workspace e sozinha leva 403.
#
# client_email do JSON da conta de servico.
GOOGLE_SA_CLIENT_EMAIL=
# private_key do JSON, EM UMA LINHA SO, entre aspas duplas, com os \n literais
# (copie e cole o valor do JSON exatamente como ele esta la).
GOOGLE_SA_PRIVATE_KEY=
# Admin do dominio que a conta de servico "vira" (impersonacao).
GOOGLE_ADMIN_SUBJECT=

# Eventos gravados no banco (CSV). Vazio = download,copy,source_copy,
# sync_item_content,edit,trash,delete. "view" NAO entra aqui: ele e consultado
# ao vivo na tela, sem gravar, porque e o evento mais volumoso de longe.
#
# Atencao: os nomes do Google nao sao 1-para-1 com o que a gente chama.
# DOWNLOAD  -> download
# COPIA     -> copy (arquivo novo) + source_copy (original)
#              + sync_item_content (sync do Drive para Computador; no Admin
#                Console ele aparece como "Item content synced", invertido)
# EDIT      -> edit
# DELETE    -> trash (mandou pra lixeira, o caso comum) + delete (definitiva)
# Tirar "trash" daqui deixa a coluna de exclusoes quase sempre vazia.
GOOGLE_DRIVE_EVENTOS=

# Quantos dias buscar na primeira sincronizacao (o Google guarda 6 meses).
GOOGLE_DRIVE_BACKFILL_DIAS=30
# Por quantos dias manter os eventos no nosso banco. 0 = nunca apagar.
GOOGLE_DRIVE_RETENCAO_DIAS=365

# ---------- Utilitarios (tela /utils) ----------
# Pasta do Drive com os instaladores (a mesma do antigo bit.ly/prsistemas).
# Usada por duas coisas:
#  - a pagina /utils, um encurtador com login: pede a senha do GTI e redireciona
#    para a pasta (nao chama API nenhuma);
#  - a aba Suporte > Utilitarios, que lista o conteudo da pasta pela Drive API
#    e por isso depende do escopo drive.readonly (passo 4 acima).
# Vale o ID puro ou a URL da pasta colada do navegador. Sem isto, as duas
# respondem 503.
# A pasta precisa continuar como "qualquer pessoa com o link": o PC do
# colaborador nao tem conta Google.
GOOGLE_DRIVE_UTILS_FOLDER_ID=
